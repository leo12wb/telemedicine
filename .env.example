APP_NAME="Sistema de Telemedicina"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─────────────────────────────────────────────
# Banco de dados — PostgreSQL
# ─────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=telemedicina
DB_USERNAME=telemedicina
DB_PASSWORD=secret

# ─────────────────────────────────────────────
# Sessão e cache
# ─────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database

# ─────────────────────────────────────────────
# Fila
# ─────────────────────────────────────────────
QUEUE_CONNECTION=database

# ─────────────────────────────────────────────
# Filesystem
# ─────────────────────────────────────────────
FILESYSTEM_DISK=local

# ─────────────────────────────────────────────
# E-mail — Mailpit (desenvolvimento)
# ─────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@telemedicina.local"
MAIL_FROM_NAME="${APP_NAME}"
MAILPIT_PORT=8025

# ─────────────────────────────────────────────
# Sanctum
# ─────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8080
SANCTUM_TOKEN_EXPIRATION=1440

# ─────────────────────────────────────────────
# Frontend (Vite)
# ─────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
VITE_API_URL="${APP_URL}/api/v1"
